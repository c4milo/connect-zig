.{
    .name = .connect_zig,
    .version = "0.0.0",
    .fingerprint = 0x25c0784958afdaae,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The HTTP transport of `connect_colibri`, and through its `tls` module, chapulin.
        .colibri = .{
            .url = "git+https://github.com/c4milo/colibri?ref=v0.15.0#de74e9c56ec7e6101fe6d4f982c87b8294075c50",
            .hash = "colibri-0.10.0-Wo-AvlFGqAR_LUBCLNuroMe947lTb6fGON05K9JX8WZz",
        },
        // JSON for proto3 JSON and the Connect error bodies, and the compression codecs.
        .stdx = .{
            .url = "git+https://github.com/c4milo/stdx#0c0ba959bda1a0e318e9171d4542beae3df262cc",
            .hash = "stdx-0.0.0-BD60tuF5NQByxf5nikkIoKXfpwr6OhHXuSP71hE5v0Ux",
        },
        // Developer tooling only, never linked into the library (decision 15). Lazy, and requested
        // only when connect-zig is the root build.
        .pepegrillo = .{
            .url = "git+https://github.com/c4milo/pepegrillo#9ae244b9ab55eb8c7259a656d08db85c9f8c42e8",
            .hash = "pepegrillo-0.0.0-axiFUFeJDACO8UB_GWT7OSbSKD2QOChXCg68MdfzduJq",
            .lazy = true,
        },
        // The event loop of the examples, at the commit colibri v0.14.1 pins: Rotor v0.9.0. Lazy, and requested
        // only when connect-zig is the root build, like pepegrillo.
        .rotor = .{
            .url = "git+https://github.com/c4milo/rotor#5a5d7d72d8ac4469a48b2a30d77380ac9dd7b90e",
            .hash = "rotor-0.9.0-YZkxRHY2FQCOGvEpDOWDofpk-UhPMwgUpaU3GyaBzhda",
            .lazy = true,
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src", "LICENSE", "README.md" },
}
