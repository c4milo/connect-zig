.{
    .name = .connect_zig,
    .version = "0.1.0",
    .fingerprint = 0x25c0784958afdaae,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The HTTP transport of `connect_colibri`, and through its `tls` module, chapulin.
        .colibri = .{
            .url = "git+https://github.com/c4milo/colibri?ref=v0.17.1#967bd10000ff6e08beffa8692e7b703e3e812305",
            .hash = "colibri-0.10.0-Wo-AvgxssgQYXWfIW7xWrDjLUdhr-9yy6YL5Ps1KLTBt",
        },
        // JSON for proto3 JSON and the Connect error bodies, and the compression codecs.
        .stdx = .{
            .url = "git+https://github.com/c4milo/stdx?ref=v0.1.1#0eedb8667d8091870b23150e730113c4cc76f579",
            .hash = "stdx-0.1.1-BD60trfSQACegwqe5zSn7ZITfheze7Ue0YhHIFn1DEes",
        },
        // Developer tooling only, never linked into the library (decision 15). Lazy, and requested
        // only when connect-zig is the root build.
        .pepegrillo = .{
            .url = "git+https://github.com/c4milo/pepegrillo#580a9d18671013e1c5ba8b661f6f744f755ab54e",
            .hash = "pepegrillo-0.0.0-axiFUDMpDQBYetBeYihxFqXr-_dGi1rf4GzSVeY-GzP4",
            .lazy = true,
        },
        // The event loop of the examples, at the commit colibri pins: Rotor v0.11.0. Lazy, and
        // requested only when connect-zig is the root build, like pepegrillo.
        .rotor = .{
            .url = "git+https://github.com/c4milo/rotor#f2890f5283fd5577243f6472648a05dda7a7f4e6",
            .hash = "rotor-0.11.0-YZkxRH0dJwBgz9oa8yO6YOTVtpFTnV6Iiz7C0OwjTffl",
            .lazy = true,
        },
        // The `jws` calls of the `oidc` module (decision 34): chapulin v0.8.0, at the commit colibri
        // pins. `build/chapulin.zig` asks for its object with colibri's own request, so a program
        // that links colibri and `oidc` links one chapulin.
        .chapulin = .{
            .url = "git+https://github.com/c4milo/chapulin#c45f661dd22150e5c8eee4530c77e201fcaadc75",
            .hash = "chapulin-0.8.0-btv9NtaXPgAzJNj3yL-HBtNu5Z5jM4UBLiO4s9o3VwOh",
        },
    },
    // What a project that depends on connect-zig fetches. `build.zig` imports `build/`, so the
    // list names it; `tools/package_check.sh` builds a project against these files alone.
    .paths = .{ "build.zig", "build.zig.zon", "build", "src", "LICENSE", "README.md" },
}
