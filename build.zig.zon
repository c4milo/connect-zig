.{
    .name = .connect_zig,
    .version = "0.0.0",
    .fingerprint = 0x25c0784958afdaae,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The HTTP transport of `connect_colibri`, and through its `tls` module, chapulin.
        .colibri = .{
            .url = "git+https://github.com/c4milo/colibri?ref=v0.16.1#14ae68a99e171b5547e4a172968c668160a12c94",
            .hash = "colibri-0.10.0-Wo-AvneJrgTz3ktOUj8iEpa-KotDoQofp4PM6KRCZwHi",
        },
        // JSON for proto3 JSON and the Connect error bodies, and the compression codecs.
        .stdx = .{
            .url = "git+https://github.com/c4milo/stdx#89a021c37020f60b218559a9e186cb8724213766",
            .hash = "stdx-0.0.0-BD60tlnDOADiKx-GhhQBxPwIZ-k_PKGqf2pcvcABDHz9",
        },
        // Developer tooling only, never linked into the library (decision 15). Lazy, and requested
        // only when connect-zig is the root build.
        .pepegrillo = .{
            .url = "git+https://github.com/c4milo/pepegrillo#9ae244b9ab55eb8c7259a656d08db85c9f8c42e8",
            .hash = "pepegrillo-0.0.0-axiFUFeJDACO8UB_GWT7OSbSKD2QOChXCg68MdfzduJq",
            .lazy = true,
        },
        // The event loop of the examples, at the commit colibri v0.16.1 pins: Rotor v0.10.0. Lazy, and requested
        // only when connect-zig is the root build, like pepegrillo.
        .rotor = .{
            .url = "git+https://github.com/c4milo/rotor#933985882d693e4d8b876e1403618a3fc6d989ef",
            .hash = "rotor-0.10.0-YZkxRFCxJABaRNenAUK5EC84mD-ZR3zmBesT76zmXoqu",
            .lazy = true,
        },
    },
    // What a project that depends on connect-zig fetches. `build.zig` imports `build/`, so the
    // list names it; `tools/package_check.sh` builds a project against these files alone.
    .paths = .{ "build.zig", "build.zig.zon", "build", "src", "LICENSE", "README.md" },
}
