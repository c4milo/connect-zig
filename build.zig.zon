.{
    .name = .connect_zig,
    .version = "0.5.0",
    .fingerprint = 0x25c0784958afdaae,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The HTTP transport of `connect_colibri`, which takes chapulin through stdx.crypto.
        .colibri = .{
            .url = "git+https://github.com/c4milo/colibri#e7e001f7bc2ba7a9f3952217c16595913c8d0b0a",
            .hash = "colibri-0.21.0-Wo-Avkp3tQQCuUxitwx0-hkF7-bjALOR3gARcEZZ2vrw",
        },
        // JSON for proto3 JSON and the Connect error bodies, the compression codecs, the
        // regular expressions of `protovalidate`'s `pattern` and CEL's `matches`, the type of CPU
        // features each of them takes, `platform.CpuFeatures`, and `crypto.jws`, the JWS calls of
        // the `oidc` module (decision 34). The commit colibri pins.
        .stdx = .{
            .url = "git+https://github.com/c4milo/stdx#a11db0bfcf5acb176b504e60789fa731c42b0252",
            .hash = "stdx-0.3.0-BD60to9OXQCZwP25ZzE67Ihvtvq1DoksAepvn5CBet3T",
        },
        // Developer tooling only, never linked into the library (decision 15). Lazy, and requested
        // only when connect-zig is the root build.
        .pepegrillo = .{
            .url = "git+https://github.com/c4milo/pepegrillo#ebbc168551e99196fba01392f5d092d71d275966",
            .hash = "pepegrillo-0.0.0-axiFUOKJDQDW3k9jeNmvvY-DGm-0Kwd6g8g-tiVmsGzT",
            .lazy = true,
        },
        // The event loop of the examples, at the commit colibri pins: Rotor v0.11.0. Lazy, and
        // requested only when connect-zig is the root build, like pepegrillo.
        .rotor = .{
            .url = "git+https://github.com/c4milo/rotor#af06860db3c56180557dc7d7e10ab51c58c43094",
            .hash = "rotor-0.11.0-YZkxRGc9JwCI6Lyp1nPvw5o6XKWk8KoXi3ciP7CwKEtW",
            .lazy = true,
        },
    },
    // What a project that depends on connect-zig fetches. `build.zig` imports `build/`, so the
    // list names it; `tools/package_check.sh` builds a project against these files alone.
    .paths = .{ "build.zig", "build.zig.zon", "build", "src", "LICENSE", "README.md" },
}
