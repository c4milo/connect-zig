.{
    .name = .connect_zig,
    .version = "0.5.0",
    .fingerprint = 0x25c0784958afdaae,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The HTTP transport of `connect_colibri`, and through its `tls` module, chapulin.
        .colibri = .{
            .url = "git+https://github.com/c4milo/colibri#b53e1d3a347f8fa0772f4c2ff6ea3f2442df86d0",
            .hash = "colibri-0.20.0-Wo-AvhBitQQgZxNuFgEaWT6NNIxYHIP8XQs9lyCfEA1N",
        },
        // JSON for proto3 JSON and the Connect error bodies, the compression codecs, the
        // regular expressions of `protovalidate`'s `pattern` and CEL's `matches`, and the type of
        // CPU features each of them takes, `platform.CpuFeatures`. The commit colibri pins.
        .stdx = .{
            .url = "git+https://github.com/c4milo/stdx#b643d581762bf1273b37d1ec41b5e42d8062b992",
            .hash = "stdx-0.3.0-BD60tmbTWgCw57shekeCHdudd5t82i8Nn2Ad0yzpAFQv",
        },
        // Developer tooling only, never linked into the library (decision 15). Lazy, and requested
        // only when connect-zig is the root build.
        .pepegrillo = .{
            .url = "git+https://github.com/c4milo/pepegrillo#ebbc168551e99196fba01392f5d092d71d275966",
            .hash = "pepegrillo-0.0.0-axiFUOKJDQDW3k9jeNmvvY-DGm-0Kwd6g8g-tiVmsGzT",
            .lazy = true,
        },
        // The event loop of the examples, at the commit colibri pins: Rotor v0.11.0. Lazy, and
        // requested only when connect-zig is the root build, like pepegrillo.
        .rotor = .{
            .url = "git+https://github.com/c4milo/rotor#f2890f5283fd5577243f6472648a05dda7a7f4e6",
            .hash = "rotor-0.11.0-YZkxRH0dJwBgz9oa8yO6YOTVtpFTnV6Iiz7C0OwjTffl",
            .lazy = true,
        },
        // The `jws` calls of the `oidc` module (decision 34): chapulin v0.10.0, at the commit colibri
        // pins. `build/chapulin.zig` asks for its module with colibri's own request, so a program
        // that links colibri and `oidc` links one chapulin.
        .chapulin = .{
            .url = "git+https://github.com/c4milo/chapulin#bda41cf6bfa38436a40c8a252610957c47eb3b5b",
            .hash = "chapulin-0.10.0-btv9NnAVPwCZRLdko4vhTnjcqeCa034tsWHgKjn267Nl",
        },
    },
    // What a project that depends on connect-zig fetches. `build.zig` imports `build/`, so the
    // list names it; `tools/package_check.sh` builds a project against these files alone.
    .paths = .{ "build.zig", "build.zig.zon", "build", "src", "LICENSE", "README.md" },
}
