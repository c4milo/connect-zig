.{
    .name = .validate,
    .version = "0.0.0",
    .fingerprint = 0x42123254e7a875d8,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // A project of your own names connect-zig by URL: `zig fetch --save git+https://github.com/c4milo/connect-zig`.
        .connect_zig = .{ .path = "../.." },
        .harness = .{ .path = "../harness" },
        // stdx, for `codec.Features`, the CPU features the program detects and passes. It names
        // the commit connect-zig pins as `stdx_regex`, so the type is the one protovalidate
        // takes.
        .stdx = .{
            .url = "git+https://github.com/c4milo/stdx#d92523191721fcb795bfcf63dd25984434888c76",
            .hash = "stdx-0.2.0-BD60tue7SQAGvJhLpqUP_YP-4HiuyUjvVsOzpz5Zw3Bv",
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "buf.gen.yaml", "proto", "gen", "src" },
}
