.{
    .name = .harness,
    .version = "0.0.0",
    .fingerprint = 0x3d7431e43a43a7fe,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .connect_zig = .{ .path = "../.." },
        // stdx's `crypto`, whose context each TLS value holds (colibri decision 175). The commit
        // and hash connect-zig pins, so Zig gives both requests one package.
        .stdx = .{
            .url = "git+https://github.com/c4milo/stdx#fdfbb709feeb2c558c5d21b6d6a3c7217b42bf50",
            .hash = "stdx-0.4.0-BD60tvuUXQBuq35OosQAVuvK1bsLnFksAkqhCpMeWw9H",
        },
        // The Rotor that colibri pins, at colibri's own request, so a program links one Rotor
        // (decision 41).
        .rotor = .{
            .url = "git+https://github.com/c4milo/rotor#af06860db3c56180557dc7d7e10ab51c58c43094",
            .hash = "rotor-0.11.0-YZkxRGc9JwCI6Lyp1nPvw5o6XKWk8KoXi3ciP7CwKEtW",
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src", "tls" },
}
