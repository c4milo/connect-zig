.{
    .name = .harness,
    .version = "0.0.0",
    .fingerprint = 0x3d7431e43a43a7fe,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .connect_zig = .{ .path = "../.." },
        // The stdx that connect-zig pins, at connect-zig's own request, so a program links one
        // stdx: the rounds' TLS sessions draw from its `crypto.Context` (colibri decision 175).
        .stdx = .{
            .url = "git+https://github.com/c4milo/stdx#9dd95be8e994a7a600aa1df6635ae0dc00b0bf5a",
            .hash = "stdx-0.3.0-BD60thJKXQDGoqyQKYSMUIPbMfsfR5A7sTlN-srIjq2d",
        },
        // The Rotor that colibri pins, at colibri's own request, so a program links one Rotor
        // (decision 41).
        .rotor = .{
            .url = "git+https://github.com/c4milo/rotor#af06860db3c56180557dc7d7e10ab51c58c43094",
            .hash = "rotor-0.11.0-YZkxRGc9JwCI6Lyp1nPvw5o6XKWk8KoXi3ciP7CwKEtW",
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src", "tls" },
}
