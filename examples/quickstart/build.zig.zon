.{
    .name = .quickstart,
    .version = "0.0.0",
    .fingerprint = 0xea7b0a93e654a03,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // A project of your own names connect-zig by URL: `zig fetch --save git+https://github.com/c4milo/connect-zig`.
        .connect_zig = .{ .path = "../.." },
        // The stdx that connect-zig pins, at connect-zig's own request, so a program links one
        // stdx: the client's TLS sessions draw from its `crypto.Context` (colibri decision 175).
        .stdx = .{
            .url = "git+https://github.com/c4milo/stdx#953c24cc3a9ecb150191531f359ebb471d065109",
            .hash = "stdx-0.3.0-BD60tjRdXQDRAL6x5HhzmBgLApdXv1q4k-PHrftpw-T9",
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "buf.gen.yaml", "check.sh", "proto", "gen", "src" },
}
