.{
    .name = .std_io,
    .version = "0.0.0",
    .fingerprint = 0x8ab03d3d5a3d08a3,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // A project of your own names connect-zig by URL: `zig fetch --save git+https://github.com/c4milo/connect-zig`.
        .connect_zig = .{ .path = "../.." },
        // The ELIZA example, whose generated code and handlers this server serves.
        .eliza = .{ .path = "../eliza" },
        // The examples' package, for chapulin's hook alone: this project runs on real sockets.
        .harness = .{ .path = "../harness" },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src" },
}
